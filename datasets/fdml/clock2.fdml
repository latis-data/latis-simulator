<?xml version="1.0" encoding="UTF-8"?>

<dataset id="clock2">
  <source uri=""/>
  <adapter class="latis.input.ClockAdapter"/>
  <function>
<!--  Does not yet support Index in fdml?  -->
    <scalar id="index" class = "latis.model.Index"/>
    <scalar id="time"
            type="long"
            units="milliseconds since 1970-01-01"
            class="latis.time.Time"/>
  </function>
</dataset>
